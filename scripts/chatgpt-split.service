[Unit]
Description=chatgpt.com TLS split proxy (models filtered, inference routed, control passthrough)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/chatgpt-mitm
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/codex-bridge/venv/bin/python3 /opt/chatgpt-mitm/split-proxy.py
Restart=always
RestartSec=3
StandardOutput=append:/opt/chatgpt-mitm/split.log
StandardError=append:/opt/chatgpt-mitm/split.log
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
